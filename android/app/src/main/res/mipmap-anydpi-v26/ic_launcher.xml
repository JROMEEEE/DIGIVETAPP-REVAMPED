<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive app icon (Android 8+): the DIGIVET paw on the logo's maroon, so
     Samsung and other launchers fill their icon shape instead of shrinking the
     round logo into a white square. Older phones use mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
